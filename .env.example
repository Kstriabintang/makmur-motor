# Copy to `.dev.vars` for local development (gitignored).
# These are set as Cloudflare secrets in production via `wrangler secret put`.

# Admin login
ADMIN_USERNAME=admin
# SHA-256(PBKDF2) hash of the admin password. Generate with:
#   node scripts/hash-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# Random 32+ char string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=
