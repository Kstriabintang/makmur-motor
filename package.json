{
  "name": "makmur-motor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply makmur-motor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply makmur-motor-db --remote",
    "db:seed": "node scripts/build-seed.ts",
    "db:seed:local": "node scripts/build-seed.ts && wrangler d1 execute makmur-motor-db --local --file=scripts/seed.sql",
    "db:seed:remote": "node scripts/build-seed.ts && wrangler d1 execute makmur-motor-db --remote --file=scripts/seed.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.19",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.101.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260616.1": true
  }
}
